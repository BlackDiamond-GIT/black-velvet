DJANGO_SETTINGS_MODULE=black_velvet.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://black-velvet.cz,https://www.black-velvet.cz
SITE_URL=https://black-velvet.cz
DATABASE_URL=sqlite:///db.sqlite3

# Render (prod): DJANGO_SETTINGS_MODULE=black_velvet.settings.prod
# Render auto-sets DATABASE_URL, SECRET_KEY, RENDER_EXTERNAL_HOSTNAME
# Cloudinary (prod media): CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=info@black-velvet.cz
GA4_MEASUREMENT_ID=
SITE_INSTAGRAM=
SITE_FACEBOOK=
SITE_WHATSAPP=
